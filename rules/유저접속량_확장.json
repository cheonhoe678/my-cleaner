{
  "file": "유저접속량_확장.xlsx",
  "owner": "김천회",
  "key_column": "Logid",
  "analysis": {
    "time_column": "로그인시간",
    "date_column": "접속일자",
    "group_column": "부서",
    "minutes_column": "접속시간",
    "user_column": "userid",
    "group_choices": ["부서", "서비스", "접속기기", "접속경로"],
    "minutes_valid_above": 0,
    "minutes_valid_below": 1440,
    "date_window_days": 120
  },
  "order_note": "위에서 아래로 적용한다. 모양을 먼저 맞추고(R1~R8), 표시(R9~R12)를 한 뒤, 마지막에 같은 줄을 지운다(R13). type 은 정리기가 아는 동작의 이름이고, 값(칸 이름 · 바꿀 말 · 경계)은 모두 이 파일에서 읽는다.",
  "rules": [
    {
      "id": "R1",
      "type": "strip_lower",
      "column": "userid",
      "action": "고침",
      "do": "앞뒤 공백을 지우고 대문자는 소문자로 바꾼다 (USER001 → user001)",
      "why": "같은 유저를 다르게 적었다"
    },
    {
      "id": "R2",
      "type": "map_values",
      "column": "부서",
      "action": "고침",
      "do": "앞뒤 공백을 지우고 띄어쓰기 차이와 줄임말을 정식 이름으로 바꾼다",
      "map": {
        "개발 팀": "개발팀", "개발": "개발팀",
        "영업": "영업팀",
        "인사 팀": "인사팀", "인사": "인사팀",
        "재무 팀": "재무팀", "재무": "재무팀",
        "마케팅 팀": "마케팅팀", "마케팅": "마케팅팀",
        "고객 지원팀": "고객지원팀", "고객지원": "고객지원팀"
      },
      "why": "같은 부서를 다르게 적었다"
    },
    {
      "id": "R3",
      "type": "map_values",
      "column": "부서",
      "action": "고침",
      "do": "영문 부서를 한글 정식 이름으로 바꾼다",
      "map": {
        "CS": "고객지원팀",
        "HR": "인사팀",
        "Finance": "재무팀",
        "Marketing": "마케팅팀",
        "Sales": "영업팀"
      },
      "why": "같은 부서를 영어로 적었다"
    },
    {
      "id": "R4",
      "type": "time_format",
      "column": ["로그인시간", "로그아웃시간"],
      "action": "고침",
      "do": "시간값과 글자(09:05:30)를 HH:MM:SS 글자 하나로 맞춘다",
      "format": "HH:MM:SS",
      "why": "시간의 모양이 제각각이다",
      "note": "원문에 이유가 따로 없어 «모양만 다르다»로 적음 — 고치려면 여기를 수정"
    },
    {
      "id": "R5",
      "type": "mark_pattern",
      "column": ["로그인시간", "로그아웃시간"],
      "action": "표시",
      "do": "«9시 5분»처럼 초가 없는 것은 고치지 않고 _표시 칸에 까닭을 적는다",
      "pattern": "^\\s*\\d{1,2}시 \\d{1,2}분\\s*$",
      "label": "초가 없는 시간",
      "why": "모르는 초를 지어내지 않는다"
    },
    {
      "id": "R6",
      "type": "date_format",
      "column": "접속일자",
      "action": "고침",
      "do": "2026/03/02 · 20260302 · 날짜값을 2026-03-02 하나로 맞춘다",
      "format": "YYYY-MM-DD",
      "patterns": ["^(\\d{4})/(\\d{2})/(\\d{2})$", "^(\\d{4})(\\d{2})(\\d{2})$"],
      "why": "모르는 날짜를 지어내지 않는다 (뜻이 분명한 모양만 고친다)"
    },
    {
      "id": "R7",
      "type": "mark_pattern",
      "column": "접속일자",
      "action": "표시",
      "do": "«26.03.02»처럼 연도가 두 자리라 뜻이 갈리는 것은 고치지 않고 표시한다",
      "pattern": "^\\d{2}\\.\\d{2}\\.\\d{2}$",
      "label": "연도 두 자리 날짜",
      "why": "모르는 날짜를 지어내지 않는다"
    },
    {
      "id": "R8",
      "type": "strip_unit",
      "column": "접속시간",
      "action": "고침",
      "do": "«117분»처럼 뒤에 붙은 «분»을 떼고 숫자로 바꾼다",
      "unit": "분",
      "why": "글자로 된 시간은 더할 수 없다"
    },
    {
      "id": "R9",
      "type": "mark_blank",
      "column": ["이름", "부서", "로그인시간", "로그아웃시간", "접속일자"],
      "action": "표시",
      "do": "빈칸은 채우지 않고 표시한다. 이름이 빈 줄도 같은 userid의 다른 줄에서 가져다 채우지 않는다",
      "label": "빈칸",
      "why": "모르는 값을 지어내지 않는다"
    },
    {
      "id": "R10",
      "type": "mark_range",
      "column": "접속시간",
      "action": "표시",
      "do": "0 이하이거나 1440(하루)분 이상이면 남기고 표시한다",
      "mark_if_at_most": 0,
      "mark_if_at_least": 1440,
      "label": "접속시간 범위 밖",
      "why": "입력 실수 같지만 진짜 값은 모른다"
    },
    {
      "id": "R11",
      "type": "mark_date_range",
      "column": "접속일자",
      "action": "표시",
      "do": "2020-01-01 이전이거나 2030-12-31 이후이면 남기고 표시한다",
      "from": "2020-01-01",
      "to": "2030-12-31",
      "label": "접속일자 범위 밖",
      "why": "입력 실수 같지만 진짜 날짜는 모른다"
    },
    {
      "id": "R12",
      "type": "mark_duration_mismatch",
      "column": ["로그인시간", "로그아웃시간", "접속시간"],
      "login": "로그인시간",
      "logout": "로그아웃시간",
      "duration": "접속시간",
      "action": "표시",
      "do": "로그아웃시간에서 로그인시간을 뺀 분이 접속시간과 다르면 표시한다. «9시 5분»은 1분까지 같은 것으로 본다. 시간이나 접속시간이 빈 줄은 판정하지 않는다",
      "tolerance_minutes_per_time_without_seconds": 1,
      "no_seconds_pattern": "^\\s*\\d{1,2}시 \\d{1,2}분\\s*$",
      "label": "로그아웃−로그인과 접속시간이 다름",
      "why": "어느 칸이 틀렸는지 모른다"
    },
    {
      "id": "R13",
      "type": "dedupe",
      "column": "(모든 칸)",
      "action": "삭제",
      "do": "모양을 다 맞춘 뒤 완전히 같은 줄은 하나만 남긴다",
      "why": "같은 로그를 두 번 올렸다"
    }
  ]
}
